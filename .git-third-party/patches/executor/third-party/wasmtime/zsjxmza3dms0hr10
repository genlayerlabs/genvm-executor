+++ b/crates/wasmtime/src/runtime/func.rs
@@ -1462,7 +1462,9 @@ use std::collections::BTreeMap;
 #[derive(Debug, Clone)]
 /// A fingerprint of the current state of the Wasm store, except backtrace
 pub struct Fingerprint {
-    /// all modules by name
+    /// All module instances by unique name
+    ///
+    /// Duplicate module names are suffixed with `#2`, `#3`, and so on.
     pub module_instances: BTreeMap<String, ModuleFingerprint>,
 }
 
@@ -1472,6 +1474,59 @@ impl std::fmt::Display for Fingerprint {
     }
 }
 
+impl<T: 'static> crate::Store<T> {
+    /// Computes a [`Fingerprint`] of the current state of all wasm linear
+    /// memories across every instance in this store.
+    ///
+    /// Every unshared linear memory of every instance is hashed (BLAKE3) and
+    /// grouped by module name; shared memories are recorded with an empty hash.
+    pub fn fingerprint(&mut self) -> Fingerprint {
+        self.as_context_mut().fingerprint()
+    }
+}
+
+impl<'a, T: 'static> StoreContextMut<'a, T> {
+    /// See [`Store::fingerprint`].
+    pub fn fingerprint(&mut self) -> Fingerprint {
+        use crate::runtime::vm::VMStore;
+
+        let store = self;
+
+        let mut fp = Fingerprint {
+            module_instances: BTreeMap::new(),
+        };
+
+        for inst in store.0.all_instances().collect::<Vec<_>>() {
+            let mut mod_fp = ModuleFingerprint {
+                memories: Vec::new(),
+            };
+
+            let module_name = inst.module(&mut store.0).name().unwrap_or("").to_owned();
+            let mut inst_mod_name = module_name.clone();
+            let mut duplicate = 2;
+            while fp.module_instances.contains_key(&inst_mod_name) {
+                inst_mod_name = format!("{module_name}#{duplicate}");
+                duplicate += 1;
+            }
+
+            for mem in inst.all_memories(store.0.store_opaque_mut()).collect::<Vec<_>>() {
+                let data = match &mem.1 {
+                    crate::runtime::vm::ExportMemory::Unshared(m) => m.data(&store),
+                    crate::runtime::vm::ExportMemory::Shared(_sm, _) => &[],
+                };
+
+                mod_fp
+                    .memories
+                    .push(MemoryFingerprint(blake3::hash(data).into()));
+            }
+
+            fp.module_instances.insert(inst_mod_name, mod_fp);
+        }
+
+        fp
+    }
+}
