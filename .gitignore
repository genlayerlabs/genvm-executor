# build related directories
/build
target
zig-out
zig-build
/mkmf.log
/result

# fetched third-party sources (populated by tools/git-third-party from manager)
/executor/third-party/*
!/executor/third-party/.gitkeep

# throwaway probes written by an agentic fuzzing session; a probe that finds
# something is promoted by hand into the feature directory it belongs to
/tests/integration/claude/_scratch

# per-machine record of what fuzzing sessions ruled out
/tests/integration/claude/intelligence/EXPLORED_PATHS.md

# editors
**/.vscode/*
!**/.vscode/extensions.json
!**/.vscode/settings.example.json
.idea
.envrc
*.log
/.direnv

# py
__pycache__
*.pyc
.pytest_cache
.mypy_cache
.ruff_cache
.coverage*

# apple
.DS_Store
.AppleDouble
.LSOverride

# perf
perf.data*
core.[0-9]*
node_modules

# git-hooks.nix dev-shell artifact
/.pre-commit-config.yaml
